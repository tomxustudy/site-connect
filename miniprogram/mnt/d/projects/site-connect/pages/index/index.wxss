@charset "UTF-8";.container{min-height:100vh;background-color:#f3f4f6;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-box-sizing:border-box;box-sizing:border-box}.header{background-color:#fff;padding:16rpx 24rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-box-shadow:0 1rpx 2rpx rgba(0,0,0,.05);box-shadow:0 1rpx 2rpx #0000000d}.header .user-info{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:12rpx}.header .user-info .avatar{width:32rpx;height:32rpx;background-color:#e5e7eb;border-radius:50%;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;font-size:14rpx;color:#4b5563}.header .user-info .username{font-weight:700;color:#1f2937}.header .status-badge{font-size:12rpx;color:#059669;background-color:#d1fae5;padding:2rpx 8rpx;border-radius:4rpx}.main-content{-webkit-flex:1;-ms-flex:1;flex:1;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;padding:32rpx}.page-title{text-align:center;font-size:20rpx;font-weight:800;color:#374151;margin-bottom:32rpx}.grid-container{display:grid;grid-template-columns:1fr 1fr;grid-auto-rows:160rpx;gap:20rpx}.grid-item{border-radius:24rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;color:#fff;-webkit-box-shadow:0 10rpx 15rpx -3rpx rgba(0,0,0,.1);box-shadow:0 10rpx 15rpx -3rpx #0000001a;-webkit-transition:opacity .1s;transition:opacity .1s;position:relative}.grid-item:active{opacity:.8;-webkit-transform:scale(.98);-ms-transform:scale(.98);transform:scale(.98)}.grid-item .icon{font-size:48rpx;margin-bottom:8rpx}.grid-item .label{font-size:24rpx;font-weight:700}.grid-item.bg-blue{background-color:#2563eb;-webkit-box-shadow:0 10rpx 20rpx -5rpx rgba(37,99,235,.4);box-shadow:0 10rpx 20rpx -5rpx #2563eb66}.grid-item.bg-orange{background-color:#f97316;-webkit-box-shadow:0 10rpx 20rpx -5rpx rgba(249,115,22,.4);box-shadow:0 10rpx 20rpx -5rpx #f9731666}.grid-item.bg-green{background-color:#16a34a;-webkit-box-shadow:0 10rpx 20rpx -5rpx rgba(22,163,74,.4);box-shadow:0 10rpx 20rpx -5rpx #16a34a66}.grid-item.empty{background:transparent;-webkit-box-shadow:none;box-shadow:none}.footer-info{margin-top:48rpx;text-align:center}.footer-info text{display:block;color:#9ca3af;font-size:14rpx;margin-top:4rpx}
